{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "tests/**", "*.ts", "*.json", "!package-lock.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Existing findings that need behaviour review, not a mechanical fix. Warn until the
      // follow-up (DevSecOps Phase 1 backlog: awesome-web lint debt) fixes them, then remove.
      "correctness": { "useExhaustiveDependencies": "warn" },
      "a11y": { "useAriaPropsSupportedByRole": "warn" },
      "suspicious": { "noArrayIndexKey": "warn" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
